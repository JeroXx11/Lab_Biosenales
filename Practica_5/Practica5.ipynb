    "# Finalmente, verificamos numéricamente que el error máximo respecto a la señal original sea prácticamente cero\n",
    "# Esto para corroborar que la señal construida a partir de este metodo si este correcta\n",
    "error_maximo = np.max(np.abs(signal - signal_reconstruida))\n",
    "print(f\"Error máximo de reconstrucción entre signal e ifft(fft(signal)): {error_maximo:.2e}\")\n",
    "\n",
    "# Graficamos la señal original vs. la reconstruida mediante IFFT, para corroborar que se haya reconstruido fielmente\n",
    "plt.figure(figsize=(10, 6))\n",
    "plt.plot(t, signal, label=\"Señal original\", color='crimson', linewidth=2.5)\n",
    "plt.plot(t, signal_reconstruida, '--', label=\"Señal reconstruida con np.fft.ifft()\", color='navy', linewidth=1.8)\n",
    "plt.title(\" Comparación entre señal original y Transformada Inversa de Fourier (IFFT)\")\n",
    "plt.xlabel(\"Tiempo [s]\")\n",
    "plt.ylabel(\"Amplitud [V]\")\n",
    "plt.xlim(0, 2 * Tp)   # Mostramos 2 periodos para comprobar la superposición exacta\n",
    "plt.grid(True)\n",
    "plt.legend()\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
